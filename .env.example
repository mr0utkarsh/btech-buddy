# =============================================================================
# BTech Buddy — Environment Configuration
# Copy to `.env` and fill in real values. NEVER commit `.env` to git.
# =============================================================================

# ------------------------------ SUPABASE ------------------------------
# Project URL:  https://<project-ref>.supabase.co
SUPABASE_URL=
# Service role key — server only (backend). Never expose in frontend.
SUPABASE_SERVICE_ROLE_KEY=
# JWT secret (from Supabase dashboard > Authentication > JWT Secret)
# Required only if your project still uses HS256 tokens (older projects).
SUPABASE_JWT_SECRET=

# ------------------------- ONE-TIME SUPER ADMIN SETUP -------------------------
# SECURITY: Previous versions of this file shipped a real, working credential.
# Those credentials must be considered COMPROMISED and rotated immediately:
#   1. Change the password in the Supabase dashboard (Authentication > Users).
#   2. Revoke/rotate the service role key and JWT secret.
#   3. Revoke any admin session tokens issued under the old credential.
# The backend auto-creates the initial super admin on startup when both are set.
# Alternatively, use the /setup one-time flow with SETUP_TOKEN.
# Set the email of the initial super admin.
INITIAL_SUPER_ADMIN_EMAIL=
# Set the initial password (choose a strong one). Never hardcode in source.
INITIAL_SUPER_ADMIN_PASSWORD=
# Optional token that enables the POST /api/auth/setup one-time flow.
SETUP_TOKEN=

# ------------------------------ BACKEND ------------------------------
# Comma-separated list of allowed frontend origins (no trailing slash).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# Public base URL of the FastAPI backend (used by the frontend).
# The frontend reads it as VITE_API_URL.
API_BASE_URL=http://localhost:8000

# Rate limits (slowapi syntax)
API_RATE_LIMIT=60/minute
DOWNLOAD_RATE_LIMIT=20/minute
PREVIEW_RATE_LIMIT=60/minute
SETUP_RATE_LIMIT=5/minute
CONTACT_RATE_LIMIT=3/hour

# PDF limits
MAX_UPLOAD_MB=50
MAX_PDF_PAGES=300

# Watermark
WATERMARK_TEXT=BTech Buddy

# Signed URL lifetime (seconds) for internal storage fetches
SIGNED_URL_TTL=60

# Storage bucket name (created by supabase/migrations/0001_schema.sql)
STORAGE_BUCKET=pdfs

# ------------------------------ FRONTEND ------------------------------
# Vite reads these at build time (prefix VITE_). Put them in frontend/.env
# VITE_API_URL=http://localhost:8000
# VITE_SUPABASE_URL=https://<project-ref>.supabase.co
# VITE_SUPABASE_ANON_KEY=
